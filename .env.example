# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://guardian:guardian_dev_password@localhost:5432/api_guardian

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# AWS S3 / Fargate
AWS_REGION=us-east-1
