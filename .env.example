FARGATE_SUBNET_ID=subnet-xxxxxx
FARGATE_SECURITY_GROUP_ID=sg-xxxxxx

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# LLM Gateway
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
